#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=24G
#SBATCH --time=01:00:00
#SBATCH -p acpu
#SBATCH --qos=cpu-normal
#SBATCH --account=XXXXX
#SBATCH --mail-type=end
#SBATCH --mail-user=XXXXX
#SBATCH --job-name=quast_HOLA_final
#SBATCH --output=/code/HOLA-genoscape/quast/quast_HOLA_final.out
#SBATCH --error=/code/HOLA-genoscape/quast/quast_HOLA_final.err

module load miniforge
mamba activate assembly

export HAP_DIR=/projects/c838062464@colostate.edu/code/HOLA-genoscape/curpretext
export OUTPUT_DIR=/scratch/alpine/c838062464@colostate.edu/HOLA/assembly/draft_assembly
mkdir -p $OUTPUT_DIR

# Split scaffolds is optional, but is helpful when looking at contig metrics in your final assembly
# It is not needed when running on your uncurated haplotypes that are output from hifiasm or even yahs.

quast $HAP_DIR/bEreAlp2_v5_2209.hap1.1.primary.curated.fa \
        --large \
        -e \
        -t 16 \
        -o $OUTPUT_DIR/bEreAlp_hap1_contigs_final_assembly \
        --split-scaffolds