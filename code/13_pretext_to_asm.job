#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH -p acpu
#SBATCH --qos=cpu-normal
#SBATCH --account=XXXXX
#SBATCH --mail-type=end
#SBATCH --mail-user=XXXXX
#SBATCH --job-name=pretext-to-asm_v5
#SBATCH --output=/code/HOLA-genoscape/curpretext/pretext-to-asm_v5.out
#SBATCH --error=/code/HOLA-genoscape/curpretext/pretext-to-asm_v5.err

module load miniforge
source activate assembly

export PTA=/code/agp-tpf-utils/src/tola/assembly/scripts

python $PTA/pretext_to_asm.py \
-a /HOLA/assembly/curationpretext/HOLA_hap1_hap2_reordered.fa \
-p /HOLA/assembly/draft_assembly/bEreAlp2_hr_FINAL_2209.pretext.agp \
-o bEreAlp2_v5_2209.fa

