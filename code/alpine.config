process {
    executor = 'slurm'
    queue = 'acpu'
    clusterOptions = '--account=YOURACCOUNTHERE --qos=cpu-normal'
    errorStrategy = 'retry'
    maxRetries = 2
    time = '24h'

    withName: 'BWAMEM2_INDEX' {
        memory = 120.GB
        cpus   = 16
        time   = '4h'
    }

    withName: '.*MINIMAP2_ALIGN.*' {
        memory = 64.GB
        cpus   = 16
        time   = '24h'
    }

    withName: '.*SAMTOOLS_MERGE.*' {
        time = '24h'
    }
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/PATH/TO/CACHE/singularity_cache'
}

executor {
    queueSize = 50
    submitRateLimit = '10/1min'
}

report { overwrite = true }
timeline { overwrite = true }
