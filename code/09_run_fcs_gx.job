#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --mem=512G
#SBATCH --time=72:00:00
#SBATCH -p amem
#SBATCH --qos=mem-long
#SBATCH --account=XXXXX
#SBATCH --mail-type=end
#SBATCH --mail-user=XXXXX
#SBATCH --job-name=fcs-gx_HOLA_hap1_scaffolded_test1
#SBATCH --output=/code/HOLA-genoscape/fcs_gx/fcs-gx_HOLA_hap1_scaffolded_test1.out
#SBATCH --error=/code/HOLA-genoscape/fcs_gx/fcs-gx_HOLA_hap1_scaffolded_test1.err

module load singularity/3.7.4
module load miniforge

export HAP_DIR=/HOLA/assembly/assemb_allHiC/yahs
export OUTPUT_DIR=/HOLA/assembly/assemb_allHiC/yahs/fcs_gx
mkdir -p $OUTPUT_DIR

export FCS_DEFAULT_IMAGE=/code/fcs-gx.sif


source $(conda info --base)/etc/profile.d/conda.sh
conda activate assembly
export GXDB_LOC=/scratch/alpine/youraccount

python3 ./fcs.py screen genome \
    --fasta $HAP_DIR/HOLA_hap1_scaffolds_final.fa \
    --out-dir $OUTPUT_DIR \
    --gx-db "$GXDB_LOC/gxdb" \
    --tax-id 135430